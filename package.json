{
  "name": "table-component",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test-headless": "ng test ui --browsers=ChromeHeadless --watch=false --code-coverage",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "ci-lint": "npm run lint",
    "ci-test": "npm run test-headless",
    "remove-dist": "rm -rf ./dist/",
    "build-lib": "ng build ui --configuration production",
    "move-scss": "cp -avr ./projects/ui/src/scss ./dist/ui/scss",
    "build-and-move": "npm run remove-dist && npm run build-lib && npm run move-scss",
    "pub-stable": "npm publish ./dist/ui --tag stable",
    "everything-stable": "npm run build-and-move && npm run pub-stable"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "15.2.9",
